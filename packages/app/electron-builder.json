{
  "appId": "io.github.blursedperf.docketeer",
  "productName": "Docketeer",
  "electronVersion": "45.4.1",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "!**/*.map",
    "package.json"
  ],
  "asar": true,
  "npmRebuild": false,
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "linux": {
    "target": [
      "AppImage",
      "pacman",
      "deb"
    ],
    "category": "Office",
    "executableName": "docketeer",
    "icon": "build/icon.png",
    "synopsis": "Offline Markdown notes with plugins",
    "maintainer": "blursedperf",
    "desktop": {
      "entry": {
        "StartupWMClass": "Docketeer",
        "Keywords": "notes;markdown;citations;aglc;"
      }
    }
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "category": "public.app-category.productivity",
    "icon": "build/icon.png",
    "identity": "-",
    "hardenedRuntime": false
  },
  "dmg": {
    "title": "Docketeer ${version}"
  },
  "publish": null,
  "pacman": {
    "depends": [
      "gtk3",
      "nss",
      "alsa-lib",
      "libxss",
      "libxtst",
      "libnotify",
      "xdg-utils"
    ],
    "packageName": "docketeer",
    "fpm": [
      "--replaces",
      "quire",
      "--conflicts",
      "quire"
    ]
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnss3",
      "libasound2t64 | libasound2",
      "libxss1",
      "libxtst6",
      "libnotify4",
      "xdg-utils"
    ],
    "packageName": "docketeer",
    "fpm": [
      "--replaces",
      "quire",
      "--conflicts",
      "quire"
    ]
  }
}
