{
  "name": "@quire/ios",
  "version": "0.24.2",
  "private": true,
  "type": "module",
  "description": "Docketeer for iPhone and iPad: the web side of the native shell (docs/mobile/PLAN.md).",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run && node build.mjs",
    "build:xcode": "node scripts/build-xcode.mjs",
    "test:xcode": "node scripts/build-xcode.mjs --test",
    "shots:ios": "node scripts/build-xcode.mjs --shots && node ../../scripts/shots-diff.mjs Docketeer/build/shots --platform ios"
  }
}
